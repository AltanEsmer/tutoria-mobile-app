# Tutoria Mobile App — Environment Variables
# Copy this file to .env and fill in the values

# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Tutoria API
EXPO_PUBLIC_API_URL=https://api-dev.tutoria.ac

# Feature Flags
EXPO_PUBLIC_ENABLE_NFC_MOCK=false
# When EXPO_PUBLIC_ENABLE_NFC_MOCK=true, this module ID is returned by every mock scan.
# Must be a real moduleId from the backend or lesson load will return 404 Module not found.
#
# To find a valid moduleId:
#   1. Run the app with the home screen loaded for an active profile.
#   2. Look in Metro logs for: [Missions] Available moduleIds: [...]
#   3. Copy any moduleId from that list into the value below.
# Or curl directly:
#   curl -H "Authorization: Bearer <token>" "$EXPO_PUBLIC_API_URL/v1/modules/missions?profileId=<id>"
EXPO_PUBLIC_NFC_MOCK_MODULE_ID=module-a
