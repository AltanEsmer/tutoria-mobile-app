    "axios": "^1.13.6",
    "expo": "~55.0.12",
    "expo-audio": "~55.0.12",
    "expo-auth-session": "~55.0.12",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "^55.0.32",
    "expo-font": "^55.0.4",
    "expo-haptics": "~55.0.13",
