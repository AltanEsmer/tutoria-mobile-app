#!/bin/sh

cd "$(git rev-parse --show-toplevel)"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 Running pre-commit checks..."

npm run lint
if [ $? -ne 0 ]; then
  echo "${RED}❌ ESLint failed. Please fix the errors above before committing.${NC}"
  exit 1
fi

npm run format:check
if [ $? -ne 0 ]; then
  echo "${RED}❌ Prettier check failed. Run \`npm run format\` to auto-fix formatting issues.${NC}"
  exit 1
fi

echo "${GREEN}✅ Pre-commit checks passed!${NC}"
exit 0
